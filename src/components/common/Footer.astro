---
import { Icon } from 'astro-icon/components';

const currentYear = new Date().getFullYear();
---

<footer class="bg-pet-dark text-white border-t border-zinc-800 font-sans" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Rodapé institucional</h2>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-14 sm:pt-16 pb-8">
    <!-- 1. Três Colunas no Centro (Sem linhas por baixo dos títulos) -->
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-8 text-center md:text-left">
      <!-- Coluna 1: Navegação do Website -->
      <div class="space-y-4 flex flex-col items-center md:items-start">
        <h3 class="font-serif text-xl font-semibold text-white tracking-wide w-full max-w-[240px] md:max-w-none text-center md:text-left">
          Navegação
        </h3>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a href="#" onclick="event.preventDefault();" class="text-zinc-300 hover:text-pet-teal-300 transition-colors cursor-pointer">
              Cremação Individual e Coletiva
            </a>
          </li>
          <li>
            <a href="#" onclick="event.preventDefault();" class="text-zinc-300 hover:text-pet-teal-300 transition-colors cursor-pointer">
              Mural Memorial Online
            </a>
          </li>
          <li>
            <a href="#" onclick="event.preventDefault();" class="text-zinc-300 hover:text-pet-teal-300 transition-colors cursor-pointer">
              Salas de Despedida e Missão
            </a>
          </li>
          <li>
            <a href="#" onclick="event.preventDefault();" class="text-zinc-300 hover:text-pet-teal-300 transition-colors cursor-pointer">
              Perguntas Frequentes & Legislação
            </a>
          </li>
          <li>
            <a href="#" onclick="event.preventDefault();" class="text-zinc-300 hover:text-pet-teal-300 transition-colors cursor-pointer">
              Contactos e Localização
            </a>
          </li>
        </ul>
      </div>

      <!-- Coluna 2: Centro de Sintra -->
      <div class="space-y-4 flex flex-col items-center md:items-start">
        <h3 class="font-serif text-xl font-semibold text-white tracking-wide w-full max-w-[240px] md:max-w-none text-center md:text-left">
          Centro de Sintra
        </h3>
        <p class="text-zinc-300 text-sm leading-relaxed font-light">
          Estrada de Chão de Meninos, Linhó<br />
          2710-530 Sintra, Portugal
        </p>
        <div class="pt-1 space-y-2 text-sm">
          <a 
            href="#" 
            onclick="event.preventDefault();"
            class="flex items-center gap-2 text-white hover:text-pet-teal-300 transition-colors font-medium justify-center md:justify-start cursor-pointer"
          >
            <Icon name="tabler:phone" class="w-4 h-4 text-pet-teal-400 shrink-0" aria-hidden="true" />
            <span>914 347 109 (24 Horas)</span>
          </a>
          <div class="flex items-center gap-2 text-zinc-300 text-xs justify-center md:justify-start">
            <Icon name="tabler:clock" class="w-4 h-4 text-zinc-400 shrink-0" aria-hidden="true" />
            <span>Atendimento & Recolhas 24h / 365 dias</span>
          </div>
        </div>
      </div>

      <!-- Coluna 3: Centro de Pombal -->
      <div class="space-y-4 flex flex-col items-center md:items-start">
        <h3 class="font-serif text-xl font-semibold text-white tracking-wide w-full max-w-[240px] md:max-w-none text-center md:text-left">
          Centro de Pombal
        </h3>
        <p class="text-zinc-300 text-sm leading-relaxed font-light">
          Parque Industrial Manuel da Mota<br />
          3100-354 Pombal, Portugal
        </p>
        <div class="pt-1 space-y-2 text-sm">
          <a 
            href="#" 
            onclick="event.preventDefault();"
            class="flex items-center gap-2 text-white hover:text-pet-teal-300 transition-colors font-medium justify-center md:justify-start cursor-pointer"
          >
            <Icon name="tabler:phone" class="w-4 h-4 text-pet-teal-400 shrink-0" aria-hidden="true" />
            <span>910 754 666 (24 Horas)</span>
          </a>
          <div class="flex items-center gap-2 text-zinc-300 text-xs justify-center md:justify-start">
            <Icon name="tabler:clock" class="w-4 h-4 text-zinc-400 shrink-0" aria-hidden="true" />
            <span>Atendimento & Recolhas 24h / 365 dias</span>
          </div>
        </div>
      </div>
    </div>

    <!-- 2. PET MEMORIAL a Grande no Rodapé (Sem linha acima) -->
    <div class="py-10 sm:py-14 my-8 sm:my-10 text-center overflow-hidden">
      <span class="font-serif font-bold text-4xl sm:text-6xl md:text-7xl lg:text-8xl tracking-[0.2em] sm:tracking-[0.25em] text-zinc-700/50 hover:text-zinc-500/70 transition-colors duration-500 uppercase select-none block">
        PET MEMORIAL
      </span>
    </div>

    <!-- 3. Linha Inferior com Direitos à Esquerda e Submenu de Políticas à Direita -->
    <div class="pt-4 border-t border-zinc-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-zinc-400">
      <!-- Lado Esquerdo -->
      <div class="text-center sm:text-left">
        <p>&copy; {currentYear} Pet Memorial. Todos os direitos reservados.</p>
      </div>

      <!-- Lado Direito: Políticas com Submenu Tipo Caixa de Seleção no Hover -->
      <div class="relative group" tabindex="0">
        <button
          type="button"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-zinc-400 hover:text-white bg-zinc-900/60 hover:bg-zinc-800/80 border border-zinc-800/80 hover:border-zinc-700 transition-colors focus:outline-none focus:ring-2 focus:ring-pet-teal-500 cursor-pointer"
          aria-haspopup="true"
          aria-label="Abrir menu de políticas e termos legais"
        >
          <span>Políticas</span>
          <Icon name="tabler:chevron-up" class="w-3.5 h-3.5 text-zinc-400 group-hover:text-pet-teal-300 transition-transform duration-200 group-hover:-translate-y-0.5" aria-hidden="true" />
        </button>

        <!-- Submenu tipo caixa de seleção suspenso para cima -->
        <div 
          class="absolute right-0 bottom-full mb-2 w-56 bg-zinc-900 border border-zinc-700/90 rounded-xl shadow-2xl p-2 opacity-0 invisible translate-y-2 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 group-focus-within:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 transition-all duration-200 z-50 pointer-events-none group-hover:pointer-events-auto group-focus-within:pointer-events-auto"
          role="menu"
          aria-orientation="vertical"
        >
          <div class="px-3 py-1.5 text-[10px] font-semibold uppercase tracking-wider text-zinc-300 border-b border-zinc-800/80 mb-1">
            Informação Legal
          </div>
          <a
            href="#"
            onclick="event.preventDefault();"
            role="menuitem"
            class="flex items-center gap-2 px-3 py-2 text-xs text-zinc-300 hover:text-white hover:bg-zinc-800/90 rounded-lg transition-colors cursor-pointer"
          >
            <Icon name="tabler:shield-lock" class="w-4 h-4 text-pet-teal-400 shrink-0" aria-hidden="true" />
            <span>Política de Privacidade</span>
          </a>
          <a
            href="#"
            onclick="event.preventDefault();"
            role="menuitem"
            class="flex items-center gap-2 px-3 py-2 text-xs text-zinc-300 hover:text-white hover:bg-zinc-800/90 rounded-lg transition-colors cursor-pointer"
          >
            <Icon name="tabler:cookie" class="w-4 h-4 text-pet-teal-400 shrink-0" aria-hidden="true" />
            <span>Política de Cookies</span>
          </a>
          <a
            href="#"
            onclick="event.preventDefault();"
            role="menuitem"
            class="flex items-center gap-2 px-3 py-2 text-xs text-zinc-300 hover:text-white hover:bg-zinc-800/90 rounded-lg transition-colors cursor-pointer"
          >
            <Icon name="tabler:file-text" class="w-4 h-4 text-pet-teal-400 shrink-0" aria-hidden="true" />
            <span>Termos e Condições</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
